# AulaGen - Environment Configuration
# https://aulagen.com

APP_NAME=AulaGen
APP_ENV=local
APP_KEY=base64:change-me
APP_DEBUG=true
APP_URL=http://localhost

# Database
# - Docker: usa PostgreSQL+pgvector (variables definidas en docker-compose.yml)
# - Local: usa SQLite (archivo database/database.sqlite)
# - En desarrollo local, pon DB_CONNECTION=sqlite para usar el archivo local.
# - En producción/Docker, las variables DB_* vienen definidas por docker-compose.yml
#
# OJO: El archivo .env del host está bind-mountado al contenedor Docker (. : /var/www/html).
# Laravel le da prioridad al .env sobre las variables de entorno del sistema en modo development.
# Por eso en Docker es recomendable no depender del .env host y dejar que compose env pase por
# el Passthrough del ServeCommand (fix aplicado: DB_* añadidos a $passthroughVariables).
#
# Para más info: docs/INSTALL_TECHNICAL.md

# ----------
# SQLITE (local development)
# ----------
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=aulagen
DB_PASSWORD=secret

# ----------
# POSTGRES (Docker / production)
# ----------
# Estas variables son sobreescritas por docker-compose.yml en el entorno Docker.
# Dejarlas vacías o con valores por defecto no afecta si se usa Docker con compose.
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=aulagen
# DB_USERNAME=aulagen
# DB_PASSWORD=secret

# ----------
# Redis (Caché, Colas, Sesiones)
# ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ----------
# API de IA (elige uno o deja los comentarios según tu proveedor)
# ----------
AI_PROVIDER=auto            # auto | ollama | gemini | openai | local
AI_ENABLED=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_EMBEDDING_DIM=768
AI_RAG_TOP_K=6
AI_RATE_LIMIT=10
AI_MAX_UPLOAD_MB=40

# ----------
# Aplicación
# ----------
SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=sync